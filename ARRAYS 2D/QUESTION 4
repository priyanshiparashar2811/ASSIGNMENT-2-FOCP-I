#include <stdio.h>

#define MAX_SIZE 100

int main(void) {
    int rows, cols, peaks = 0;
    long long matrix[MAX_SIZE][MAX_SIZE];

    if (scanf("%d %d", &rows, &cols) != 2 ||
        rows < 1 || rows > MAX_SIZE || cols < 1 || cols > MAX_SIZE) return 0;

    for (int i = 0; i < rows; i++)
        for (int j = 0; j < cols; j++)
            if (scanf("%lld", &matrix[i][j]) != 1) return 0;

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            long long value = matrix[i][j];
            int isPeak = 1;

            if (i > 0 && value <= matrix[i - 1][j]) isPeak = 0;
            if (i + 1 < rows && value <= matrix[i + 1][j]) isPeak = 0;
            if (j > 0 && value <= matrix[i][j - 1]) isPeak = 0;
            if (j + 1 < cols && value <= matrix[i][j + 1]) isPeak = 0;

            if (isPeak) peaks++;
        }
    }

    printf("%d\n", peaks);
    return 0;
}
