#include <stdio.h>

#define MAX_SIZE 100

int main(void) {
    int rows, cols;
    long long matrix[MAX_SIZE][MAX_SIZE];

    if (scanf("%d %d", &rows, &cols) != 2 ||
        rows < 1 || rows > MAX_SIZE || cols < 1 || cols > MAX_SIZE) return 0;

    for (int i = 0; i < rows; i++)
        for (int j = 0; j < cols; j++)
            if (scanf("%lld", &matrix[i][j]) != 1) return 0;

    for (int i = 0; i < rows; i++) {
        long long sum = 0;
        for (int j = 0; j < cols; j++) sum += matrix[i][j];
        if (i > 0) printf(" ");
        printf("%lld", sum);
    }
    printf("\n");

    for (int j = 0; j < cols; j++) {
        long long sum = 0;
        for (int i = 0; i < rows; i++) sum += matrix[i][j];
        if (j > 0) printf(" ");
        printf("%lld", sum);
    }
    printf("\n");
    return 0;
}
