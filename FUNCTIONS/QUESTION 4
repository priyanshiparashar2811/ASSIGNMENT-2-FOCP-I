#include <stdio.h>

int isPerfectSquare(long long n) {
    if (n < 0) return 0;
    if (n < 2) return 1;

    long long low = 1, high = n / 2;
    while (low <= high) {
        long long mid = low + (high - low) / 2;
        if (mid == n / mid && n % mid == 0) return 1;
        if (mid > n / mid) high = mid - 1;
        else low = mid + 1;
    }
    return 0;
}

int main(void) {
    long long n;
    if (scanf("%lld", &n) != 1) return 0;
    printf("%d\n", isPerfectSquare(n));
    return 0;
}
