# ASSIGNMENT-2-FOCP-I#include <stdio.h>

#define MAX_N 100000

int main(void) {
    int n, current = 0, best = 0;
    long long values[MAX_N];
    if (scanf("%d", &n) != 1 || n < 0 || n > MAX_N) return 0;

    for (int i = 0; i < n; i++)
        if (scanf("%lld", &values[i]) != 1) return 0;

    for (int i = 0; i < n; i++) {
        if (i == 0 || values[i] <= values[i - 1]) current = 1;
        else current++;

        if (current > best) best = current;
    }

    printf("%d\n", best);
    return 0;
}
